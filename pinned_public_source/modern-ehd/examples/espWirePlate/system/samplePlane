FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      samplePlane;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            surfaces;
libs            (sampling);

interpolationScheme cellPoint;
surfaceFormat   raw;

fields          (U V rhoq E p);

surfaces
(
    zmid
    {
        type        cuttingPlane;
        point       (0 0.05 0.005);
        normal      (0 0 1);
        interpolate true;
    }
);

