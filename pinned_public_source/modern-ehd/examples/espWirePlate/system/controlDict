FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     electrostaticSimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         2500;

deltaT          1;

writeControl    timeStep;

writeInterval   2500;

purgeWrite      2;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    magE
    {
        type            mag;
        libs            (fieldFunctionObjects);
        field           E;
        result          magE;
        writeControl    timeStep;
        writeInterval   50;
        log             false;
    }

    EmagWireAvg
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        regionType      patch;
        name            wire;
        operation       areaAverage;
        fields          (magE);
        writeControl    timeStep;
        writeInterval   50;
        log             true;
        writeFields     no;
    }
}

