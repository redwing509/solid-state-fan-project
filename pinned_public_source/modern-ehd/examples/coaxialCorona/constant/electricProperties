FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      electricProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// vacuum permittivity [A^2 s^4/(kg m^3)]
epsilon0        8.854e-12;

// ion mobility in air (positive ions) [m^2/(V s)]
muq             1.8e-04;

// ion diffusivity [m^2/s]; 0 for the verification case (the analytic
// solution neglects diffusion)
Dq              0;

// fluid mass density [kg/m^3]
rhoFluid        1.225;

// EHD body force in the momentum equation
electricForce   on;

