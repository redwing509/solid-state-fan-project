FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    wire
    {
        type            noSlip;
    }
    outer
    {
        type            noSlip;
    }
    symX
    {
        type            symmetry;
    }
    symY
    {
        type            symmetry;
    }
    frontAndBack
    {
        type            empty;
    }
}

